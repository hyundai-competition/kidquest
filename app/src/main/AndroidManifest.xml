<?xml version="1.0" encoding="utf-8"?>
<!-- 앱 권한과 시작 화면. 쓸 신호의 권한만 적는다.
     차 신호 권한은 Vehicle SDK 2.3.2가 함수에 붙인 권한 이름을 따랐다. 탑승·벨트 CAR_SEATS, 깜빡이 CAR_LIGHTS,
     와이퍼 CAR_WINDOWS, 기어 CAR_DRIVE, 잔량 CAR_ENERGY, 실내 온도 CAR_CLIMATE. SDK에 없는 READ_WINDSHIELD_WIPERS와 CAR_POWERTRAIN은 뺐다. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <!-- 백업을 끈다. 기기에는 연령과 배지만 저장한다. -->
    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_vroomie"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <uses-library
            android:name="android.car"
            android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!-- 주행 중에도 쓸 수 있다는 선언(DO). 실제 동작은 첫 시험에서 확인한다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
